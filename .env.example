# OpenAI API Key
# Required for embeddings (text-embedding-3-large) and LLM operations
OPENAI_API_KEY=sk-proj-...

# Firecrawl API Key
# Required for article content extraction during ingestion
FIRECRAWL_API_KEY=fc-...

# Supabase Project URL and backend API key
# For local development, use Supabase local instance
# For production, use your Supabase project credentials
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_API_KEY=your-secret-key-here

# Trigger.dev Configuration
# Required for background ingestion jobs
TRIGGER_SECRET_KEY=tr_dev_...

# Node Environment
NODE_ENV=development
