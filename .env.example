# OpenAI API Key
# Required for embeddings (text-embedding-3-large) and LLM operations
OPENAI_API_KEY=sk-proj-...

# Firecrawl API Key
# Required for article content extraction during ingestion
FIRECRAWL_API_KEY=fc-...

# Supabase Project URL and backend API key
# For local development, use Supabase local instance
# For production, use your Supabase project credentials
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_API_KEY=your-secret-key-here

# Langfuse tracing (optional; tracing is off without the keys). See docs/tracing.md
# Base URL is region specific: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Vercel AI Gateway key (evals only: LLM judge and comparison model). See docs/evals.md
AI_GATEWAY_API_KEY=...

# Node Environment
NODE_ENV=development
