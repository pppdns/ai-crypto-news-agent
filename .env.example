# OpenAI API Key
# Required for embeddings (text-embedding-3-large) and LLM operations
OPENAI_API_KEY=sk-proj-...

# Firecrawl API Key
# Required for article content extraction during ingestion
FIRECRAWL_API_KEY=fc-...

# Supabase Configuration
# For local development, use Supabase local instance
# For production, use your Supabase project credentials

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Key (public-facing, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (bypasses RLS, server-side only)
# NEVER expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Trigger.dev Configuration
# Required for background ingestion jobs
TRIGGER_SECRET_KEY=tr_dev_...

# Optional: Node Environment
NODE_ENV=development
