{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:run)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format:check)",
      "Bash(npm ci)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline)"
    ],
    "ask": [
      "Bash(npm run trigger:deploy:*)",
      "Bash(npx trigger.dev@latest deploy:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(npx tsx scripts/crawl-news.ts:*)"
    ],
    "deny": ["Read(./.env.local)", "Read(./.env.*.local)", "Read(./.env.sentry-build-plugin)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
