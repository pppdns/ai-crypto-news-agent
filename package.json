{
  "name": "ai-crypto-news-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npx --yes tsc --noEmit --skipLibCheck --project tsconfig.json",
    "ngrok": "ngrok http 3000",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "supabase:gen-types:dev": "npx supabase gen types typescript --local --schema public > supabase/database.types.ts && npx prettier --write supabase/database.types.ts && git add supabase/database.types.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "prepare": "husky && husky install"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.56",
    "@ai-sdk/react": "^2.0.81",
    "@heroui/react": "^2.8.5",
    "@langchain/langgraph": "^1.0.1",
    "@mendable/firecrawl-js": "^4.4.1",
    "@supabase/supabase-js": "^2.76.1",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.0",
    "ai": "^5.0.81",
    "framer-motion": "^12.23.24",
    "langchain": "^1.0.2",
    "lucide-react": "^0.548.0",
    "markdown-it": "^14.1.0",
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "openai": "^6.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.54.11",
    "tailwindcss": "^4",
    "tiktoken": "^1.0.22",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
