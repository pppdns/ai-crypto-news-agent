# These values are the default values for a self-hosted Supabase: https://github.com/supabase/supabase/blob/master/docker/.env.example
DEFAULT_SUPABASE_DB_PASSWORD=postgres
DEFAULT_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DEFAULT_SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Next.js environment variables for local Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Docs for Supabase session vs transaction modes: https://supabase.com/docs/guides/database/connecting-to-postgres#supavisor-session-mode-port-5432
SUPABASE_DATABASE_URL_SESSION_MODE=postgres://postgres:$DEFAULT_SUPABASE_DB_PASSWORD@localhost:54322/postgres
SUPABASE_DATABASE_URL_TRANSACTION_MODE=postgres://postgres:$DEFAULT_SUPABASE_DB_PASSWORD@localhost:54322/postgres
SUPABASE_DATABASE_SSL_CERT=
SUPABASE_SECRET_KEY=$DEFAULT_SUPABASE_SECRET_KEY
